# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Neon Postgres connection string.
# From the Vercel Marketplace Neon integration: this is injected automatically as
# DATABASE_URL when you install it on your Vercel project.
# For local development, copy the "pooled" connection string from your Neon
# project dashboard (Connect > Connection string).
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"

# The 6-digit PIN used to log in to the app. Keep this private.
APP_PIN="123456"

# Random secret used to sign the login session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-hex-string"
